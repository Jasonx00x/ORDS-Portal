NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional server-only key for internal email delivery logs. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_ORDS_MARKETING_URL=https://ordsmusic.com
NEXT_PUBLIC_ORDS_PORTAL_URL=https://ords-portal.netlify.app
# Server-only Brevo transactional email configuration. Never prefix these with NEXT_PUBLIC_.
BREVO_API_KEY=your-server-only-brevo-key
BREVO_BOOKING_CONFIRMATION_TEMPLATE_ID=your-customer-template-id
BREVO_ADMIN_BOOKING_TEMPLATE_ID=your-admin-template-id
ORDS_ADMIN_EMAIL=primary-admin@example.com
ORDS_SECONDARY_ADMIN_EMAIL=secondary-admin@example.com
